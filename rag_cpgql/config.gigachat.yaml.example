# Пример конфигурации для GigaChat API
#
# Инструкция по настройке:
# 1. Скопируйте этот файл в config.yaml (или добавьте секцию llm.gigachat в существующий config.yaml)
# 2. Установите GIGACHAT_AUTH_KEY через PowerShell:
#    $env:GIGACHAT_AUTH_KEY = "YOUR_AUTHORIZATION_KEY"
# 3. Запустите проверку: python test_gigachat.py

# Основная конфигурация CPG
cpg:
  type: "postgresql"  # или "linux_kernel", "llvm", "generic"
  database:
    path: "cpg.duckdb"

# Конфигурация LLM
llm:
  # Провайдер: "gigachat", "openai", "anthropic"
  provider: "gigachat"

  # Параметры GigaChat
  gigachat:
    # Client ID (выдаётся при регистрации приложения)
    client_id: "019a7e2b-aeb3-78c4-ba3d-ddc1142b4ee6"

    # Scope (тип доступа)
    # GIGACHAT_API_PERS - персональный доступ
    # GIGACHAT_API_CORP - корпоративный доступ
    scope: "GIGACHAT_API_PERS"

    # Модель
    # Доступные модели:
    # - GigaChat-2-Pro (самая мощная)
    # - GigaChat (базовая)
    # - GigaChat-Plus (расширенная)
    model: "GigaChat-2-Pro"

    # Temperature (креативность ответов: 0.0 - детерминированный, 1.0 - креативный)
    temperature: 0.7

    # Максимальное количество токенов в ответе
    max_tokens: 2000

    # Timeout запроса (секунды)
    timeout: 60

    # Проверка SSL сертификатов
    # true - проверять (рекомендуется для продакшена)
    # false - не проверять (для разработки)
    verify_ssl_certs: false

    # API endpoint (обычно не нужно менять)
    # base_url: "https://gigachat.devices.sberbank.ru/api/v1"

  # Параметры для других провайдеров (если используются)
  openai:
    model: "gpt-4"
    temperature: 0.7

  anthropic:
    model: "claude-3-opus-20240229"
    temperature: 0.7

# Конфигурация векторного хранилища
vector_store:
  type: "chroma"
  path: "./chroma_db"
  embedding_model: "all-MiniLM-L6-v2"

# Конфигурация RAG
rag:
  top_k_qa: 3
  top_k_cpgql: 5
  enable_hybrid_retrieval: true
  enable_cache: true

# Логирование
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
