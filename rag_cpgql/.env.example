# =============================================================================
# CodeGraph Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string (asyncpg driver required for API)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codegraph

# DuckDB path for CPG queries (relative or absolute)
DUCKDB_PATH=./cpg.duckdb

# -----------------------------------------------------------------------------
# API Server Settings
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Change this in production! Use at least 64 characters
API_JWT_SECRET=change-me-in-production-use-64-chars-minimum-secret-key-here
API_JWT_ALGORITHM=HS256

# Default admin credentials (used by create-admin command)
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# GigaChat (Sber)
GIGACHAT_CLIENT_ID=your-client-id
GIGACHAT_CLIENT_SECRET=your-client-secret
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# OpenAI (alternative)
# OPENAI_API_KEY=sk-...

# Anthropic (alternative)
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# OAuth2 Providers (Optional)
# -----------------------------------------------------------------------------
# GitHub OAuth App
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitLab OAuth
# OAUTH_GITLAB_CLIENT_ID=
# OAUTH_GITLAB_CLIENT_SECRET=
# OAUTH_GITLAB_URL=https://gitlab.com

# Keycloak / OIDC
OAUTH_KEYCLOAK_SERVER_URL=
OAUTH_KEYCLOAK_REALM=
OAUTH_KEYCLOAK_CLIENT_ID=
OAUTH_KEYCLOAK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# LDAP/Active Directory (Optional)
# -----------------------------------------------------------------------------
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_GROUP_SEARCH_BASE=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Storage backend: "memory" (single instance) or "redis://host:port" (distributed)
RATE_LIMIT_STORAGE=memory

# -----------------------------------------------------------------------------
# Demo Endpoint
# -----------------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_RATE_LIMIT=30/minute

# -----------------------------------------------------------------------------
# Joern/CPG Server (Optional)
# -----------------------------------------------------------------------------
# JOERN_SERVER_HOST=localhost
# JOERN_SERVER_PORT=9000

# -----------------------------------------------------------------------------
# ChromaDB Vector Store
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chromadb_storage

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FORMAT=json  # Use JSON format for production

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
