# Environment Variables for RAG-CPGQL
# Copy this file to .env and fill in your credentials

# =============================================================================
# GigaChat API Configuration (Sber)
# =============================================================================
# Get credentials from: https://developers.sber.ru/studio/workspaces
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here

# GigaChat Scope (optional, default: GIGACHAT_API_PERS)
# Options: GIGACHAT_API_PERS, GIGACHAT_API_CORP, GIGACHAT_API_B2B
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# =============================================================================
# OpenAI API Configuration (for compatibility)
# =============================================================================
# Get API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Custom OpenAI endpoint (e.g., Azure OpenAI)
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/

# =============================================================================
# Local Model Configuration (override config.yaml)
# =============================================================================
# Path to local GGUF model file
# MODEL_PATH=C:/path/to/your/model.gguf

# Use fine-tuned LLMxCPG model (true) or base Qwen3 (false)
# USE_LLMXCPG=true

# Context window size
# N_CTX=8192

# GPU layers (-1 = all layers on GPU, 0 = CPU only)
# N_GPU_LAYERS=-1

# =============================================================================
# RAGAS Evaluation Configuration
# =============================================================================
# Use separate LLM for RAGAS evaluation (true) or same as agents (false)
# RAGAS_USE_SEPARATE_LLM=false

# If using separate LLM for RAGAS, specify provider
# RAGAS_PROVIDER=gigachat

# RAGAS model (if using GigaChat)
# RAGAS_GIGACHAT_MODEL=GigaChat-Pro

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Enable verbose logging for LLM providers
# LLM_VERBOSE=false

# =============================================================================
# Advanced Settings
# =============================================================================
# Auto-load .env file on import (true/false)
# AUTO_LOAD_ENV=true

# Joern server settings (optional overrides)
# JOERN_SERVER_PORT=8080
# JOERN_QUERY_TIMEOUT=60

# ChromaDB settings (optional)
# CHROMA_PERSIST_DIRECTORY=chroma_db
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# =============================================================================
# Development Settings
# =============================================================================
# Enable debug mode
# DEBUG=false

# Test mode (use smaller datasets)
# TEST_MODE=false

# Dry run (don't make API calls)
# DRY_RUN=false
