{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "RAG-CPGQL Security Scanner",
          "version": "1.0.0",
          "informationUri": "https://github.com/rag-cpgql",
          "rules": [
            {
              "id": "FILE_DJANGO_DEBUG_001",
              "name": "DEBUG=True (File Scan)",
              "shortDescription": {
                "text": "DEBUG=True (File Scan)"
              },
              "fullDescription": {
                "text": "Django DEBUG mode enabled by default"
              },
              "help": {
                "text": "Set DEBUG=False in production, use env var without True default",
                "markdown": "Set DEBUG=False in production, use env var without True default"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "CWE-489"
                ],
                "security-severity": "9.0"
              }
            },
            {
              "id": "FILE_CORS_001",
              "name": "CORS Allow All (File Scan)",
              "shortDescription": {
                "text": "CORS Allow All (File Scan)"
              },
              "fullDescription": {
                "text": "CORS configured to allow all origins"
              },
              "help": {
                "text": "Set CORS_ALLOW_ALL_ORIGINS=False, use CORS_ALLOWED_ORIGINS list",
                "markdown": "Set CORS_ALLOW_ALL_ORIGINS=False, use CORS_ALLOWED_ORIGINS list"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "CWE-346"
                ],
                "security-severity": "7.0"
              }
            },
            {
              "id": "FILE_HOSTS_001",
              "name": "ALLOWED_HOSTS Wildcard (File Scan)",
              "shortDescription": {
                "text": "ALLOWED_HOSTS Wildcard (File Scan)"
              },
              "fullDescription": {
                "text": "ALLOWED_HOSTS contains wildcard"
              },
              "help": {
                "text": "Specify explicit hostnames in ALLOWED_HOSTS",
                "markdown": "Specify explicit hostnames in ALLOWED_HOSTS"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "CWE-942"
                ],
                "security-severity": "7.0"
              }
            },
            {
              "id": "FILE_JWT_001",
              "name": "JWT Long Expiry (File Scan)",
              "shortDescription": {
                "text": "JWT Long Expiry (File Scan)"
              },
              "fullDescription": {
                "text": "JWT access token lifetime too long (days/weeks)"
              },
              "help": {
                "text": "Set ACCESS_TOKEN_LIFETIME to minutes, use refresh tokens",
                "markdown": "Set ACCESS_TOKEN_LIFETIME to minutes, use refresh tokens"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "CWE-613"
                ],
                "security-severity": "7.0"
              }
            },
            {
              "id": "FILE_PATH_001",
              "name": "Path Traversal (File Scan)",
              "shortDescription": {
                "text": "Path Traversal (File Scan)"
              },
              "fullDescription": {
                "text": "File operation without path validation"
              },
              "help": {
                "text": "Validate paths with os.path.realpath() and check prefix",
                "markdown": "Validate paths with os.path.realpath() and check prefix"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "CWE-22"
                ],
                "security-severity": "7.0"
              }
            },
            {
              "id": "FILE_TOOLBAR_001",
              "name": "Debug Toolbar (File Scan)",
              "shortDescription": {
                "text": "Debug Toolbar (File Scan)"
              },
              "fullDescription": {
                "text": "Django Debug Toolbar unconditionally enabled"
              },
              "help": {
                "text": "Enable debug_toolbar only when DEBUG is True",
                "markdown": "Enable debug_toolbar only when DEBUG is True"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "CWE-489"
                ],
                "security-severity": "5.0"
              }
            }
          ]
        }
      },
