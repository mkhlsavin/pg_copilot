# =============================================================================
# CodeGraph Leads Microservice Configuration
# Copy to .env and fill in values
# =============================================================================

# Database (separate database in same PostgreSQL cluster)
# Uses same POSTGRES_PASSWORD as main codegraph service
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql+asyncpg://codegraph:${POSTGRES_PASSWORD}@codegraph-postgres:5432/codegraph_leads

# API Authentication (for admin endpoints)
LEADS_API_KEY=your_secure_api_key_here

# Email Notifications (SMTP)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@codegraph.ru
ADMIN_EMAIL=sales@codegraph.ru

# Telegram Notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# CORS (allowed origins for form submission)
CORS_ALLOWED_ORIGINS=https://codegraph.ru,https://www.codegraph.ru

# Rate Limiting
RATE_LIMIT_LEADS_CREATE=10/minute

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
