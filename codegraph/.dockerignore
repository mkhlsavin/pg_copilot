# =============================================================================
# Docker Build Exclusions
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Python cache and compiled files
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
venv/
.venv/
env/
.env.local
.env.development
.env.test

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Build artifacts
build/
dist/
*.egg

# Data directories (will be mounted as volumes)
data/
logs/
sessions/
workspace/

# Documentation (not needed in container)
docs/
*.md
!README.md

# Tests (not needed in production container)
tests/
test_*.py
*_test.py
conftest.py

# Development files
docker-compose.override.yml
Makefile
.editorconfig
.pre-commit-config.yaml

# CI/CD configurations
.github/
.gitlab-ci.yml
.circleci/

# Claude Code files
.claude/

# Temporary files
*.tmp
*.temp
*.bak
*.log

# Large binary files
*.cpg
*.gguf
*.bin
*.model
*.duckdb

# Grafana dashboard (mounted separately)
grafana/

# Monitoring configs (mounted separately)
monitoring/

# Scripts (not needed in container)
scripts/

# Examples and notebooks
examples/
notebooks/
*.ipynb
